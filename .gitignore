# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*
.credentials.json
auth.json
*_token
*token*.txt

# Agent sessions, histories and local state
sessions/
history.jsonl
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
shell-snapshots/
file-history/
paste-cache/
session-env/

# Caches and dependencies
node_modules/
.cache/
.cache/*
**/.cache/
dist/
build/
out/
coverage/
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Self-audit local state (baseline is committed; current/raw cache is not)
.local-state/
local-state/current.yaml
local-state/*.tmp

# Python bytecode
__pycache__/
*.pyc
