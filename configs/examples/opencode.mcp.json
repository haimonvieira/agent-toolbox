{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "example-local-pinned": {
        "type": "local",
        "command": ["npx", "--yes", "some-mcp@1.2.3"]
      },
      "example-local-binary": {
        "type": "local",
        "command": ["/absolute/path/to/server", "--flag"]
      },
      "example-remote": {
        "type": "remote",
        "url": "https://mcp.example.com/mcp"
      },
      "example-remote-with-header": {
        "type": "remote",
        "url": "http://127.0.0.1:27200/mcp",
        "headers": {
          "Authorization": "Bearer <REDACTED>"
        }
      },
      "example-disabled": {
        "type": "local",
        "command": ["some-disabled-mcp"],
        "disabled": true
      }
    }
  },
  "plugin": ["example-plugin"]
}
