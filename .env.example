# Environment variables — NAMES ONLY.
# Copy to .env (which is git-ignored) and fill local values there.
# Never commit real values.

# Model providers used by the harnesses on this machine
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# Documentation lookup (optional, higher Context7 quota)
CONTEXT7_API_KEY=YOUR_CONTEXT7_KEY_HERE

# Git hosting
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# MCP servers observed/required locally
OA_WORKSPACE_TOKEN=YOUR_OPENAGENTS_WORKSPACE_TOKEN_HERE
HOSTINGER_API_TOKEN=YOUR_HOSTINGER_TOKEN_HERE
OBSIDIAN_MCP_TOKEN=YOUR_OBSIDIAN_MCP_TOKEN_HERE
STARRY_TOKEN=YOUR_STARRY_TOKEN_HERE

# Microsoft Teams / Graph (upstream-documented; not present in local config)
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID_HERE
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID_HERE
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET_HERE
