{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-toolbox/profile.schema.json",
  "title": "Agent Toolbox environment profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "profile_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "extends": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "harnesses": {
      "$ref": "#/$defs/componentBlock"
    },
    "plugins": {
      "$ref": "#/$defs/componentBlock"
    },
    "skills": {
      "$ref": "#/$defs/componentBlock"
    },
    "mcps": {
      "$ref": "#/$defs/componentBlock"
    },
    "hooks": {
      "$ref": "#/$defs/componentBlock"
    },
    "environment_variables": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "floating_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "Verified locally",
        "Verified upstream",
        "Locally detected, upstream not verified",
        "Inferred",
        "Unknown"
      ]
    },
    "last_verified": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "type": "string",
          "enum": [
            "directly_configured",
            "inherited",
            "plugin_injected",
            "plugin_managed",
            "built_in",
            "canonical_shared",
            "project_local",
            "optional",
            "unresolved"
          ]
        },
        "version": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "managed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "componentBlock": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "dynamic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "built_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "plugin_managed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "canonical_shared": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "project_local": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": false
    },
    "envVar": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "required_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
